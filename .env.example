# ── Banco de dados ────────────────────────────────────────────────────────────
# Em desenvolvimento, o Postgres do docker-compose.
POSTGRES_DB=nektis_invest
POSTGRES_USER=nektis
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nektis_invest
SPRING_DATASOURCE_USERNAME=nektis
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Produção (Neon): use o endpoint DIRETO, não o -pooler, e mantenha o
# sslmode=require. O Hikari já faz o pool do lado da aplicação.
#   SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.sa-east-1.aws.neon.tech/nektis_invest?sslmode=require
# Tamanho do pool. A Neon limita conexões por plano; 5 sobra para este tráfego.
# DB_POOL_MAX=5

# ── Perfis e portas ───────────────────────────────────────────────────────────
# dev     = gateway de pagamento falso + e-mail no log (nenhuma chave necessária)
# (vazio) = perfil padrão, usado em produção: Stripe + Resend, exige as chaves
#           abaixo. Não existe um perfil chamado "prod": em produção deixe esta
#           variável sem valor.
SPRING_PROFILES_ACTIVE=dev
PORTA_BACKEND=8080
PORTA_FRONTEND=3000

# Porta do processo. A Square Cloud injeta PORT=80 sozinha; não defina à mão.
# PORT=8080

# ── URLs ──────────────────────────────────────────────────────────────────────
# Origem liberada no CORS do backend e base dos redirecionamentos de pagamento.
URL_FRONTEND=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Base pública do backend (usada pelo pagamento simulado do perfil dev).
URL_PUBLICA_API=http://localhost:8080

# Em produção o jar serve o HTML e a API na mesma origem, então as três apontam
# para o mesmo domínio e o NEXT_PUBLIC_API_URL vira um caminho relativo (ele é
# fixado em /api/v1 no build do workflow, não precisa estar no painel):
#   URL_FRONTEND=https://invest.nektis.tech
#   URL_PUBLICA_API=https://invest.nektis.tech
#
# O URL_FRONTEND precisa ser o domínio que o VISITANTE usa, sem barra final —
# não o subdomínio interno da hospedagem. Ele é a origem liberada no CORS e a
# base do success_url da Stripe: errado, o cadastro falha com 403 e quem paga é
# devolvido para o domínio errado.

# Embed do vídeo de apresentação. Se vazio, o botão mostra "Vídeo em breve".
# É lido no BUILD do frontend (variável NEXT_PUBLIC_*), não em runtime: para
# mudar em produção, defina a variável de repositório no GitHub e refaça o build.
NEXT_PUBLIC_VIDEO_URL=

# Origens liberadas no frame-src do CSP, para o iframe do vídeo. O padrão já
# cobre YouTube e Vimeo.
# CSP_FRAME_SRC=https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com

# ── Proxy reverso ─────────────────────────────────────────────────────────────
# Estamos atrás de um proxy de confiança que sobrescreve os headers
# X-Forwarded-*? Deixe false quando o backend recebe o tráfego direto; os
# headers são forjáveis e só valem vindos de um proxy que você controla.
#
# Com true, duas coisas mudam:
#   - o rate limit passa a tirar o IP do cliente do X-Forwarded-For. Com false
#     atrás de proxy, todas as requisições parecem vir do IP do proxy e o limite
#     de 10/min vale para o site inteiro;
#   - o esquema e o host públicos são reconstruídos, sem o que o Spring enxerga
#     http:// e trata as chamadas do próprio site como se fossem de outra
#     origem — o cadastro morre com 403 "Invalid CORS request".
#
# Na Square Cloud o tráfego passa pelo proxy deles: lá vai true.
CONFIAR_PROXY=false

# ── Stripe (perfil padrão) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Price recorrente mensal em BRL (price_...), criado no painel da Stripe.
STRIPE_PRICE_ID=
# whsec_... — devolvido por `stripe listen` ou pelo endpoint de webhook.
# Sem ela o backend REJEITA todo webhook (400) e nenhuma assinatura é ativada.
STRIPE_WEBHOOK_SECRET=

# ── Resend (perfil padrão) ────────────────────────────────────────────────────
# Sem ela a aplicação NÃO SOBE no perfil padrão.
RESEND_API_KEY=
# Remetente em domínio já verificado da Nektis.
EMAIL_REMETENTE=Nektis Invest <invest@nektis.tech>

# ── Links dos canais no WhatsApp ──────────────────────────────────────────────
# Se ficarem vazios, o card de acesso mostra
# "Os links chegam no seu e-mail em breve."
WHATSAPP_NOTICIAS_URL=
WHATSAPP_NETWORKING_URL=
